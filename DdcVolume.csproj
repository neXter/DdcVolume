<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DdcVolume</AssemblyName>
    <RootNamespace>DdcVolume</RootNamespace>
    <Version>1.0.0</Version>
    <Product>DDC Volume</Product>
    <Authors>Pieter Walsweer</Authors>
    <Copyright>© 2026 Pieter Walsweer</Copyright>
    <Description>Controls monitor speaker volume via DDC/CI. Developed with the help of Claude by Anthropic.</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- allows building from Linux/WSL -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- always produce a Windows exe, even when building from WSL -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- only affects 'dotnet publish' -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

</Project>
